# Template consumed by the VeinFin installer. Copying by hand is discouraged;
# generated .env files are validated and written atomically with mode 0600.

# User-provided installation settings
INSTALLATION_PROFILE=public-https
ENABLE_MIGRATION_STAGES=false
COMPOSE_PROJECT_NAME=veinfin
TZ=Etc/UTC
PUID=1000
PGID=1000
UMASK=002
CONFIG_ROOT=/opt/veinfin
MEDIA_ROOT=/srv/media
RUNTIME_ROOT=./runtime

# Public HTTPS endpoint. VeinFin consumes this hostname but never manages DNS.
PUBLIC_HOSTNAME=media.example.test
PUBLIC_BIND_IP=0.0.0.0
HTTPS_PORT=443

# Private interfaces bind to one explicitly selected host address. Loopback is
# safe for static validation; each installation must choose its actual LAN IP.
MANAGEMENT_BIND_IP=127.0.0.1
MANAGEMENT_URL_SCHEME=http
MANAGEMENT_URL_HOST=localhost
MANAGEMENT_ALLOWED_CIDRS=127.0.0.1/32
PROTECTED_LAN_CIDRS=192.0.2.0/24
SSH_PORT=22
MANAGEMENT_USERNAME=veinfin

# Private management ports. Container-side ports are fixed service contracts.
QBITTORRENT_MANAGEMENT_PORT=8080
SONARR_MANAGEMENT_PORT=8989
RADARR_MANAGEMENT_PORT=7878
PROWLARR_MANAGEMENT_PORT=9696
BAZARR_MANAGEMENT_PORT=6767
SEERR_MANAGEMENT_PORT=5055
CONTROL_PANEL_MANAGEMENT_PORT=3000
JELLYFIN_MANAGEMENT_PORT=8096

# Optional LAN discovery override; disabled unless explicitly enabled.
ENABLE_JELLYFIN_DISCOVERY=false
JELLYFIN_DISCOVERY_BIND_IP=0.0.0.0
JELLYFIN_DISCOVERY_PORT=7359

# Reviewed tag plus immutable multi-architecture manifest digest. See
# config/images.lock and docs/IMAGE_PINS.md before changing any value.
CADDY_IMAGE_TAG=2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
JELLYFIN_IMAGE_TAG=10.11.11@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db
LEGACY_CANDIDATE_ROOT=/opt/veinfin/runtime/legacy-ui-candidate
LEGACY_CANDIDATE_PORT=18096
QBITTORRENT_IMAGE_TAG=5.3.0_v2.1.2-ls484@sha256:e887804fa9de4c60f5f0fb1f3a7e4febe40a8f69fe736f70c4e8589b1f868dab
SONARR_IMAGE_TAG=4.0.20.3014-ls1@sha256:48e36b608b461273b9dae857725cd0561a127f2c694b687318f6d0c5ce63e5c9
RADARR_IMAGE_TAG=6.4.4.10685-ls323@sha256:fc0ae3c50f8128b97e84381903ec8d6845c3a569641cb7117c124376cccb57c1
PROWLARR_IMAGE_TAG=2.6.5.5623-ls165@sha256:b3b00047ed20f6ce2b16780145cb6a0acb51c9e28ea6aa6f5dcd33c7034f1797
BAZARR_IMAGE_TAG=v1.6.2-ls369@sha256:946dc8c5bb5331418eac60050cf40a63cb8f66ac039841dda493870e3559799c
SEERR_IMAGE_TAG=v3.5.1@sha256:d8fab675b55ad293ded98fd71efcfd46054cbad9746534ae1cc4794a88c0b3be
RECYCLARR_IMAGE_TAG=8.8.0@sha256:b1fbb929ba718fdbdac2c1fc25b32b0ae916d7a5a0892c2068c9bfae6f1a9209
FLARESOLVERR_IMAGE_TAG=v3.5.2@sha256:c80ae007ce2ccdcd217a12426e4f039ef763ff90738c808d38810c3e59323767

# Optional future features; neither is implemented by the Compose design scaffold.
ENABLE_VPN_PROFILE=false
VPN_PROVIDER=
ENABLE_HARDWARE_TRANSCODING=false
TRANSCODING_DEVICE=

# Generated locally and written only to ignored mode-600 files. Deployment and
# verified application bootstrap are responsible for applying this credential.
MANAGEMENT_PASSWORD=
